# Build stage
FROM cgr.dev/chainguard/node:20.11 AS build

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY .nvmrc ./

# Install dependencies
RUN npm install

# Copy project files
COPY . .

# Build the project
RUN npm run build

# Production stage
FROM cgr.dev/chainguard/nginx:latest

# Copy built assets from build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Nginx runs as non-root by default in Chainguard images
# No need to explicitly set user or permissions

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"] 